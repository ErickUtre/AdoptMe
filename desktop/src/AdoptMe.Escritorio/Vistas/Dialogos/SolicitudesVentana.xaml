<Window x:Class="AdoptMe.Escritorio.Vistas.Dialogos.SolicitudesVentana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AdoptMe.Escritorio.Nucleo.VistasModelo.Solicitudes;assembly=AdoptMe.Escritorio.Nucleo"
        xmlns:nucleo="clr-namespace:AdoptMe.Escritorio.Nucleo;assembly=AdoptMe.Escritorio.Nucleo"
        xmlns:controles="clr-namespace:AdoptMe.Escritorio.Controles"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SolicitudesVistaModelo}"
        Title="Solicitudes de adopción" Height="520" Width="660"
        ResizeMode="NoResize"
        Background="{StaticResource Dialogo}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Foreground="White" FontSize="16" Text="{x:Static nucleo:Textos.SinSolicitudes}"
                   Visibility="{Binding SinSolicitudes, Converter={StaticResource BooleanoAVisibilidad}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Pendientes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#A9A9A9" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Mandar mensaje" Width="130" Height="28" Margin="4,0" Foreground="White" Background="SteelBlue"
                                            Command="{Binding DataContext.ContactarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Aceptar" Width="90" Height="28" Margin="4,0" Foreground="White" Background="#64CC20"
                                            Command="{Binding DataContext.AceptarSolicitudCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Rechazar" Width="90" Height="28" Margin="4,0" Foreground="White" Background="#EA5959"
                                            Command="{Binding DataContext.RechazarSolicitudCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                                <TextBlock Text="{Binding NombreAdoptante}" Foreground="White" FontSize="16" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="1" Content="Cerrar" Width="90" Height="32" HorizontalAlignment="Right" Margin="0,10,0,0"
                Foreground="White" Background="#F25C5C" Command="{Binding CerrarCommand}" />

        <controles:IndicadorCarga Grid.RowSpan="2" Visibility="{Binding EstaOcupado, Converter={StaticResource BooleanoAVisibilidad}}" />
    </Grid>
</Window>
