<Window x:Class="AdoptMe.Escritorio.Vistas.Dialogos.SeleccionUbicacionVentana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
        xmlns:vm="clr-namespace:AdoptMe.Escritorio.Nucleo.VistasModelo.Ubicaciones;assembly=AdoptMe.Escritorio.Nucleo"
        xmlns:nucleo="clr-namespace:AdoptMe.Escritorio.Nucleo;assembly=AdoptMe.Escritorio.Nucleo"
        xmlns:controles="clr-namespace:AdoptMe.Escritorio.Controles"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SeleccionUbicacionVistaModelo}"
        Title="Seleccionar ubicación" Height="860" Width="1000"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource Normal}" Margin="20" FontSize="24" Text="{x:Static nucleo:Textos.UbicacionImprecisa}" />

        <gmap:GMapControl x:Name="Mapa" Grid.Row="1" Margin="20,0" MouseDoubleClick="AlHacerDobleClic" />

        <Grid Grid.Row="2" Margin="20">
            <TextBlock Style="{StaticResource Normal}" FontSize="18" Margin="0,0,280,0" Text="{Binding Descripcion}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Style="{StaticResource BotonGeneral}" Content="Guardar" Background="#44C22B" FontSize="14" Margin="0,0,20,0"
                        IsDefault="True" Command="{Binding GuardarCommand}" />
                <Button Style="{StaticResource BotonGeneral}" Content="Cancelar" Background="#D94F4F" FontSize="14"
                        IsCancel="True" />
            </StackPanel>
        </Grid>

        <controles:IndicadorCarga Grid.RowSpan="3" Visibility="{Binding EstaOcupado, Converter={StaticResource BooleanoAVisibilidad}}" />
    </Grid>
</Window>
