<UserControl x:Class="AdoptMe.Escritorio.Vistas.Paginas.EdicionAdopcionVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AdoptMe.Escritorio.Nucleo.VistasModelo.Adopciones;assembly=AdoptMe.Escritorio.Nucleo"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EdicionAdopcionVistaModelo}"
             d:DesignHeight="940" d:DesignWidth="1508">
    <Grid Background="{StaticResource Fondo}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource Titulo}" Margin="40" Text="Información de la mascota" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="100,20,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TextoInformacion}"><Run Text="Nombre:" /> <Run Text="{Binding Mascota.Nombre, Mode=OneWay}" /></TextBlock>
                    <Button Style="{StaticResource BotonEditar}" Command="{Binding EditarNombreCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TextoInformacion}"><Run Text="Especie:" /> <Run Text="{Binding Mascota.Especie, Mode=OneWay}" /></TextBlock>
                    <Button Style="{StaticResource BotonEditar}" Command="{Binding EditarEspecieCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TextoInformacion}"><Run Text="Raza:" /> <Run Text="{Binding Mascota.Raza, Mode=OneWay}" /></TextBlock>
                    <Button Style="{StaticResource BotonEditar}" Command="{Binding EditarRazaCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TextoInformacion}"><Run Text="Edad:" /> <Run Text="{Binding Mascota.Edad, Mode=OneWay}" /></TextBlock>
                    <Button Style="{StaticResource BotonEditar}" Command="{Binding EditarEdadCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TextoInformacion}"><Run Text="Sexo:" /> <Run Text="{Binding Mascota.Sexo, Mode=OneWay}" /></TextBlock>
                    <Button Style="{StaticResource BotonEditar}" Command="{Binding EditarSexoCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TextoInformacion}"><Run Text="Tamaño:" /> <Run Text="{Binding Mascota.Tamano, Mode=OneWay}" /></TextBlock>
                    <Button Style="{StaticResource BotonEditar}" Command="{Binding EditarTamanoCommand}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="40">
                <Grid>
                    <Image MaxHeight="400" Stretch="UniformToFill"
                           Source="{Binding Foto, Converter={StaticResource BytesAImagen}, ConverterParameter='pack://application:,,,/Recursos/Imagenes/MascotaDefault.png'}">
                        <Image.Effect>
                            <BlurEffect Radius="15" />
                        </Image.Effect>
                    </Image>
                    <Image MaxHeight="400" Margin="80,0" Stretch="Uniform"
                           Source="{Binding Foto, Converter={StaticResource BytesAImagen}, ConverterParameter='pack://application:,,,/Recursos/Imagenes/MascotaDefault.png'}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource BotonEditar}" ToolTip="Cambiar foto" Command="{Binding CambiarFotoCommand}" />
                        <Button Style="{StaticResource BotonBase}" Width="50" Margin="10,0,0,0" ToolTip="Ampliar imagen" Command="{Binding ExpandirFotoCommand}">
                            <Image Source="/Recursos/Imagenes/IconoExpandirImagen.png" Opacity="0.8" />
                        </Button>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,20">
                    <TextBlock Style="{StaticResource Normal}" Width="600" Text="{Binding Mascota.Descripcion}" />
                    <Button Style="{StaticResource BotonEditar}" VerticalAlignment="Top" Command="{Binding EditarDescripcionCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="50,30">
            <Button Style="{StaticResource BotonGeneral}" Content="Ver video" Background="{StaticResource Acento}" Margin="0,0,20,0" Command="{Binding VerVideoCommand}" />
            <Button Style="{StaticResource BotonGeneral}" Content="Cambiar video" Background="#0D80C1" Margin="0,0,20,0" Command="{Binding CambiarVideoCommand}" />
            <Button Style="{StaticResource BotonGeneral}" Content="Regresar" Background="{StaticResource Peligro}" Command="{Binding RegresarCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
