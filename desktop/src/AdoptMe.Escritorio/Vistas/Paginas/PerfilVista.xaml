<UserControl x:Class="AdoptMe.Escritorio.Vistas.Paginas.PerfilVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AdoptMe.Escritorio.Nucleo.VistasModelo.Perfil;assembly=AdoptMe.Escritorio.Nucleo"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PerfilVistaModelo}"
             d:DesignHeight="940" d:DesignWidth="1508">
    <Grid Background="{StaticResource Fondo}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource Titulo}" Margin="40" Text="Información del usuario" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="100,20,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TextoInformacion}" Width="560" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                        <Run Text="Nombre:" /> <Run Text="{Binding Perfil.Nombre, Mode=OneWay}" />
                    </TextBlock>
                    <Button Style="{StaticResource BotonEditar}" Command="{Binding EditarNombreCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TextoInformacion}" Width="560" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                        <Run Text="Correo:" /> <Run Text="{Binding Perfil.Acceso.Correo, Mode=OneWay}" />
                    </TextBlock>
                    <Button Style="{StaticResource BotonEditar}" Command="{Binding EditarCorreoCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,40">
                    <TextBlock Style="{StaticResource TextoInformacion}" Width="560">
                        <Run Text="Teléfono:" /> <Run Text="{Binding Perfil.Telefono, Mode=OneWay}" />
                    </TextBlock>
                    <Button Style="{StaticResource BotonEditar}" Command="{Binding EditarTelefonoCommand}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Normal}" Margin="0,0,0,20" Text="{Binding DescripcionUbicacion}" />
                <Button Style="{StaticResource BotonGeneral}" HorizontalAlignment="Left" FontSize="26"
                        Background="{StaticResource UbicacionMarca}" Content="Actualizar ubicación"
                        Command="{Binding ActualizarUbicacionCommand}" />
            </StackPanel>

            <Grid Grid.Column="1" Margin="40" VerticalAlignment="Top">
                <Image MaxHeight="400" Stretch="UniformToFill"
                       Source="{Binding Foto, Converter={StaticResource BytesAImagen}, ConverterParameter='pack://application:,,,/Recursos/Imagenes/IconoUsuarioDefecto.png'}">
                    <Image.Effect>
                        <BlurEffect Radius="15" />
                    </Image.Effect>
                </Image>
                <Image MaxHeight="400" Margin="80,0" Stretch="Uniform"
                       Source="{Binding Foto, Converter={StaticResource BytesAImagen}, ConverterParameter='pack://application:,,,/Recursos/Imagenes/IconoUsuarioDefecto.png'}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource BotonEditar}" ToolTip="Cambiar foto" Command="{Binding CambiarFotoCommand}" />
                    <Button Style="{StaticResource BotonBase}" Width="50" Margin="10,0,0,0" ToolTip="Ampliar imagen" Command="{Binding ExpandirFotoCommand}">
                        <Image Source="/Recursos/Imagenes/IconoExpandirImagen.png" Opacity="0.8" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
