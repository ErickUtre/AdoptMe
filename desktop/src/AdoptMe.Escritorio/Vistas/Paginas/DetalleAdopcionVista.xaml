<UserControl x:Class="AdoptMe.Escritorio.Vistas.Paginas.DetalleAdopcionVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AdoptMe.Escritorio.Nucleo.VistasModelo.Adopciones;assembly=AdoptMe.Escritorio.Nucleo"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DetalleAdopcionVistaModelo}"
             d:DesignHeight="940" d:DesignWidth="1508">
    <Grid Background="{StaticResource Fondo}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource Titulo}" Margin="40" Text="Información de la mascota" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="100,20,10,20" DataContext="{Binding Adopcion.Mascota}">
                <TextBlock Style="{StaticResource TextoInformacion}"><Run Text="Nombre:" /> <Run Text="{Binding Nombre, Mode=OneWay}" /></TextBlock>
                <TextBlock Style="{StaticResource TextoInformacion}"><Run Text="Especie:" /> <Run Text="{Binding Especie, Mode=OneWay}" /></TextBlock>
                <TextBlock Style="{StaticResource TextoInformacion}"><Run Text="Raza:" /> <Run Text="{Binding Raza, Mode=OneWay}" /></TextBlock>
                <TextBlock Style="{StaticResource TextoInformacion}"><Run Text="Edad:" /> <Run Text="{Binding Edad, Mode=OneWay}" /></TextBlock>
                <TextBlock Style="{StaticResource TextoInformacion}"><Run Text="Sexo:" /> <Run Text="{Binding Sexo, Mode=OneWay}" /></TextBlock>
                <TextBlock Style="{StaticResource TextoInformacion}"><Run Text="Tamaño:" /> <Run Text="{Binding Tamano, Mode=OneWay}" /></TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="40">
                <Grid>
                    <Image MaxHeight="400" Stretch="UniformToFill"
                           Source="{Binding Foto, Converter={StaticResource BytesAImagen}, ConverterParameter='pack://application:,,,/Recursos/Imagenes/MascotaDefault.png'}">
                        <Image.Effect>
                            <BlurEffect Radius="15" />
                        </Image.Effect>
                    </Image>
                    <Image MaxHeight="400" Margin="80,0" Stretch="Uniform"
                           Source="{Binding Foto, Converter={StaticResource BytesAImagen}, ConverterParameter='pack://application:,,,/Recursos/Imagenes/MascotaDefault.png'}" />
                    <Button Style="{StaticResource BotonBase}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="50"
                            ToolTip="Ampliar imagen" Command="{Binding ExpandirFotoCommand}">
                        <Image Source="/Recursos/Imagenes/IconoExpandirImagen.png" Opacity="0.8" />
                    </Button>
                </Grid>
                <TextBlock Style="{StaticResource Normal}" Margin="0,20" Text="{Binding Adopcion.Mascota.Descripcion}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="50,30">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource BotonGeneral}" Content="Ver video" Background="{StaticResource Acento}" Margin="0,0,20,0"
                        Command="{Binding VerVideoCommand}" />
                <Button Style="{StaticResource BotonGeneral}" Content="Enviar mensaje" Background="#588BDF"
                        Visibility="{Binding PuedeSolicitar, Converter={StaticResource BooleanoAVisibilidad}}"
                        Command="{Binding EnviarMensajeCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BotonGeneral}" Content="Solicitar" Background="{StaticResource Exito}" Margin="0,0,20,0"
                        Visibility="{Binding PuedeSolicitar, Converter={StaticResource BooleanoAVisibilidad}}"
                        Command="{Binding SolicitarCommand}" />
                <Button Style="{StaticResource BotonGeneral}" Content="Regresar" Background="{StaticResource Peligro}"
                        Command="{Binding RegresarCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
