<Window x:Class="AdoptMe.Escritorio.Vistas.Ventanas.InicioSesionVentana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AdoptMe.Escritorio.Nucleo.VistasModelo.Acceso;assembly=AdoptMe.Escritorio.Nucleo"
        xmlns:controles="clr-namespace:AdoptMe.Escritorio.Controles"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:InicioSesionVistaModelo}"
        Title="AdoptMe - Inicio de sesión" Height="720" Width="560"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource Primario}">
        <StackPanel VerticalAlignment="Center">
            <Image Source="/Recursos/Imagenes/LogoAdoptMe.png" Height="220" Margin="0,0,0,24" />
            <TextBlock Style="{StaticResource Subtitulo}" HorizontalAlignment="Center" Text="Inicio de sesión" />

            <TextBox Margin="0,40,0,12"
                     MaxLength="100"
                     controles:TextoSugerido.Texto="Correo"
                     Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Width="300" Margin="0,12">
                <PasswordBox MaxLength="100"
                             controles:TextoSugerido.Texto="Contraseña"
                             controles:ContrasenaEnlazable.Contrasena="{Binding Contrasena}"
                             Visibility="{Binding ContrasenaVisible, Converter={StaticResource BooleanoInvertidoAVisibilidad}}" />
                <TextBox MaxLength="100"
                         controles:TextoSugerido.Texto="Contraseña"
                         Text="{Binding Contrasena, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding ContrasenaVisible, Converter={StaticResource BooleanoAVisibilidad}}" />
                <Button Style="{StaticResource BotonBase}"
                        HorizontalAlignment="Right" Margin="0,0,10,0" Width="36"
                        ToolTip="Mostrar u ocultar contraseña"
                        Command="{Binding AlternarVisibilidadContrasenaCommand}">
                    <Image Source="/Recursos/Imagenes/IconoOcultar.png" />
                </Button>
            </Grid>

            <Button Style="{StaticResource BotonGeneral}"
                    Content="REGÍSTRATE"
                    Background="Transparent"
                    FontSize="22" FontStyle="Italic" FontWeight="Light"
                    Effect="{x:Null}"
                    Margin="0,12"
                    Command="{Binding IrARegistroCommand}" />

            <Button Style="{StaticResource BotonGeneral}"
                    Content="Iniciar sesión"
                    IsDefault="True"
                    Background="{StaticResource Informacion}"
                    Command="{Binding IniciarSesionCommand}" />
        </StackPanel>

        <controles:IndicadorCarga Visibility="{Binding EstaOcupado, Converter={StaticResource BooleanoAVisibilidad}}" />
    </Grid>
</Window>
