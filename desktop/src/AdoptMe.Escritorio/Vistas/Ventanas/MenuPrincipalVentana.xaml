<Window x:Class="AdoptMe.Escritorio.Vistas.Ventanas.MenuPrincipalVentana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AdoptMe.Escritorio.Nucleo.VistasModelo.Principal;assembly=AdoptMe.Escritorio.Nucleo"
        xmlns:controles="clr-namespace:AdoptMe.Escritorio.Controles"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MenuPrincipalVistaModelo}"
        Title="AdoptMe" Height="1080" Width="1920"
        MinHeight="720" MinWidth="1200"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="412" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid Background="{StaticResource Primario}">
                <StackPanel Margin="25">
                    <Grid>
                        <Button Style="{StaticResource BotonBase}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                ToolTip="Mi perfil" Command="{Binding IrAPerfilCommand}">
                            <Image Width="50" Height="50" Stretch="UniformToFill"
                                   Source="{Binding FotoPerfil, Converter={StaticResource BytesAImagen}, ConverterParameter='pack://application:,,,/Recursos/Imagenes/IconoUsuarioDefecto.png'}">
                                <Image.Clip>
                                    <EllipseGeometry RadiusX="25" RadiusY="25" Center="25,25" />
                                </Image.Clip>
                            </Image>
                        </Button>
                        <TextBlock Text="Bienvenido:" Margin="60,5" Foreground="White" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding NombreUsuario}" Margin="60,22" Foreground="White" FontWeight="Bold" />
                        <Button Style="{StaticResource BotonBase}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding CerrarSesionCommand}">
                            <StackPanel>
                                <Image Source="/Recursos/Imagenes/IconoCerrarSesion.png" Width="30" />
                                <TextBlock Text="Cerrar sesión" Foreground="White" FontSize="9" Margin="0,6" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Image Source="/Recursos/Imagenes/LogoAdoptMe.png" Width="200" Margin="0,20,0,0" />
                    <Border Background="White" Height="2" Margin="-25,40,-25,20" />

                    <Button Style="{StaticResource BotonMenu}" Command="{Binding IrAMapaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Image Style="{StaticResource IconoMenu}" Source="/Recursos/Imagenes/IconoMenuPrincipal.png" />
                            <TextBlock Style="{StaticResource TextoMenu}" Text="Menú principal" />
                        </StackPanel>
                    </Button>

                    <StackPanel Visibility="{Binding EsUsuario, Converter={StaticResource BooleanoAVisibilidad}}">
                        <Border Style="{StaticResource SeparadorMenu}" />
                        <Button Style="{StaticResource BotonMenu}" Command="{Binding IrARegistrarAdopcionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Image Style="{StaticResource IconoMenu}" Source="/Recursos/Imagenes/IconoRegistrarAdopcion.png" />
                                <TextBlock Style="{StaticResource TextoMenu}" Text="Registrar adopción" />
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource SeparadorMenu}" />
                        <Button Style="{StaticResource BotonMenu}" Command="{Binding IrAAdopcionesPropiasCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Image Style="{StaticResource IconoMenu}" Source="/Recursos/Imagenes/IconoVerAdopciones.png" />
                                <TextBlock Style="{StaticResource TextoMenu}" Text="Ver adopciones" />
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource SeparadorMenu}" />
                        <Button Style="{StaticResource BotonMenu}" Command="{Binding IrAMensajesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Image Style="{StaticResource IconoMenu}" Source="/Recursos/Imagenes/IconoMensajes.png" />
                                <TextBlock Style="{StaticResource TextoMenu}" Text="Mensajes" />
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource SeparadorMenu}" />
                        <Button Style="{StaticResource BotonMenu}" Command="{Binding IrANotificacionesCommand}"
                                Background="{Binding HayNotificacionesNuevas, Converter={StaticResource NotificacionAColor}}">
                            <StackPanel Orientation="Horizontal">
                                <Image Style="{StaticResource IconoMenu}" Source="/Recursos/Imagenes/IconoNotificacion.png" />
                                <TextBlock Style="{StaticResource TextoMenu}" Text="Notificaciones" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Visibility="{Binding EsAdministrador, Converter={StaticResource BooleanoAVisibilidad}}">
                        <Border Style="{StaticResource SeparadorMenu}" />
                        <Button Style="{StaticResource BotonMenu}" Command="{Binding IrAReportesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Image Style="{StaticResource IconoMenu}" Source="/Recursos/Imagenes/IconoGenerarReportes.png" />
                                <TextBlock Style="{StaticResource TextoMenu}" Text="Generar reportes" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Background="{StaticResource Lateral}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="140" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <ContentControl Grid.Row="1" Content="{Binding Navegador.Actual}" />
            </Grid>

            <controles:IndicadorCarga Grid.ColumnSpan="2"
                                      Visibility="{Binding Navegador.Actual.EstaOcupado, Converter={StaticResource BooleanoAVisibilidad}, FallbackValue=Collapsed}" />
        </Grid>
    </Viewbox>
</Window>
