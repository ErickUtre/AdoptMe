<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorPrimario">#207766</Color>
    <Color x:Key="ColorPrimarioOscuro">#205766</Color>
    <Color x:Key="ColorFondo">#EEEEEE</Color>
    <Color x:Key="ColorLateral">#808080</Color>
    <Color x:Key="ColorExito">#3FBD13</Color>
    <Color x:Key="ColorPeligro">#EA5959</Color>
    <Color x:Key="ColorInformacion">#187DAC</Color>
    <Color x:Key="ColorAcento">#F8C420</Color>
    <Color x:Key="ColorUbicacion">#00DF82</Color>
    <Color x:Key="ColorTarjeta">#C3C3C3</Color>
    <Color x:Key="ColorTarjetaMapa">#2F558F</Color>
    <Color x:Key="ColorBordeMapa">#284060</Color>
    <Color x:Key="ColorReporte">#9272B5</Color>
    <Color x:Key="ColorDialogo">#4A6B5A</Color>
    <Color x:Key="ColorBurbujaPropia">#207766</Color>
    <Color x:Key="ColorBurbujaAjena">#A9A9A9</Color>

    <SolidColorBrush x:Key="Primario" Color="{StaticResource ColorPrimario}" />
    <SolidColorBrush x:Key="PrimarioOscuro" Color="{StaticResource ColorPrimarioOscuro}" />
    <SolidColorBrush x:Key="Fondo" Color="{StaticResource ColorFondo}" />
    <SolidColorBrush x:Key="Lateral" Color="{StaticResource ColorLateral}" />
    <SolidColorBrush x:Key="Exito" Color="{StaticResource ColorExito}" />
    <SolidColorBrush x:Key="Peligro" Color="{StaticResource ColorPeligro}" />
    <SolidColorBrush x:Key="Informacion" Color="{StaticResource ColorInformacion}" />
    <SolidColorBrush x:Key="Acento" Color="{StaticResource ColorAcento}" />
    <SolidColorBrush x:Key="UbicacionMarca" Color="{StaticResource ColorUbicacion}" />
    <SolidColorBrush x:Key="Tarjeta" Color="{StaticResource ColorTarjeta}" />
    <SolidColorBrush x:Key="TarjetaMapa" Color="{StaticResource ColorTarjetaMapa}" />
    <SolidColorBrush x:Key="BordeMapa" Color="{StaticResource ColorBordeMapa}" />
    <SolidColorBrush x:Key="Reporte" Color="{StaticResource ColorReporte}" />
    <SolidColorBrush x:Key="Dialogo" Color="{StaticResource ColorDialogo}" />
    <SolidColorBrush x:Key="BurbujaPropia" Color="{StaticResource ColorBurbujaPropia}" />
    <SolidColorBrush x:Key="BurbujaAjena" Color="{StaticResource ColorBurbujaAjena}" />
</ResourceDictionary>
