<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controles="clr-namespace:AdoptMe.Escritorio.Controles"
                    xmlns:conversores="clr-namespace:AdoptMe.Escritorio.Conversores">

    <conversores:BytesAImagenConversor x:Key="BytesAImagen" />
    <conversores:BooleanoAVisibilidadConversor x:Key="BooleanoAVisibilidad" />
    <conversores:BooleanoAVisibilidadConversor x:Key="BooleanoInvertidoAVisibilidad" Invertir="True" />
    <conversores:TextoVacioAVisibilidadConversor x:Key="TextoVacioAVisibilidad" />
    <conversores:NuloAVisibilidadConversor x:Key="NuloAVisibilidad" />
    <conversores:BooleanoAAlineacionConversor x:Key="BooleanoAAlineacion" />
    <conversores:TipoCampoAVisibilidadConversor x:Key="TipoCampoAVisibilidad" />
    <conversores:BooleanoAPinceladaConversor x:Key="PropioABurbuja" Verdadero="{StaticResource BurbujaPropia}" Falso="{StaticResource BurbujaAjena}" />
    <conversores:BooleanoAPinceladaConversor x:Key="InvalidoABorde" Verdadero="Red" Falso="Transparent" />
    <conversores:BooleanoAPinceladaConversor x:Key="AdoptadaAColor" Verdadero="Red" Falso="Green" />
    <conversores:BooleanoAPinceladaConversor x:Key="NotificacionAColor" Verdadero="Red" Falso="Transparent" />

    <DropShadowEffect x:Key="Sombra" Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.5" />

    <Style x:Key="CampoTexto" TargetType="TextBox">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="15,5" />
        <Setter Property="Width" Value="300" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Effect" Value="{StaticResource Sombra}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="White" CornerRadius="15" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2">
                        <Grid>
                            <TextBlock Text="{TemplateBinding controles:TextoSugerido.Texto}"
                                       Foreground="Black" Opacity="0.4" Margin="17,0,0,0"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TextoVacioAVisibilidad}}" />
                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource CampoTexto}" />

    <Style TargetType="PasswordBox">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="15,5" />
        <Setter Property="Width" Value="300" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Effect" Value="{StaticResource Sombra}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="White" CornerRadius="15" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2">
                        <Grid>
                            <TextBlock Text="{TemplateBinding controles:TextoSugerido.Texto}"
                                       Foreground="Black" Opacity="0.4" Margin="17,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding (controles:ContrasenaEnlazable.EstaVacia), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanoAVisibilidad}}" />
                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Effect" Value="{StaticResource Sombra}" />
    </Style>

    <Style x:Key="FuenteBase" TargetType="TextBlock">
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="FontFamily" Value="Inter, Segoe UI" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Titulo" TargetType="TextBlock" BasedOn="{StaticResource FuenteBase}">
        <Setter Property="FontSize" Value="60" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="Subtitulo" TargetType="TextBlock" BasedOn="{StaticResource FuenteBase}">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TextoMenu" TargetType="TextBlock" BasedOn="{StaticResource FuenteBase}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TextoInformacion" TargetType="TextBlock" BasedOn="{StaticResource FuenteBase}">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="Margin" Value="0,12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Normal" TargetType="TextBlock" BasedOn="{StaticResource FuenteBase}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Etiqueta" TargetType="TextBlock" BasedOn="{StaticResource FuenteBase}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="#444444" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <Style x:Key="BotonBase" TargetType="Button">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonGeneral" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Effect" Value="{StaticResource Sombra}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}" Padding="30,9" CornerRadius="25">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borde" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonMenu" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Margin" Value="0,12" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}" Padding="0,12" CornerRadius="25">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource PrimarioOscuro}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonEditar" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="ToolTip" Value="Editar" />
        <Setter Property="Content">
            <Setter.Value>
                <Image Source="/Recursos/Imagenes/Editar.png" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconoMenu" TargetType="Image">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Margin" Value="10,0,16,0" />
    </Style>

    <Style x:Key="SeparadorMenu" TargetType="Border">
        <Setter Property="Background" Value="#949494" />
        <Setter Property="Height" Value="2" />
    </Style>

    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Tarjeta}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,18" />
        <Setter Property="Effect" Value="{StaticResource Sombra}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
    </Style>
</ResourceDictionary>
