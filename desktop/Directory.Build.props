<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <NeutralLanguage>es-MX</NeutralLanguage>
    <Company>AdoptMe</Company>
    <Product>AdoptMe Escritorio</Product>
    <Version>2.0.0</Version>
    <RaizProtos>$(MSBuildThisFileDirectory)..\protos</RaizProtos>
  </PropertyGroup>
</Project>
