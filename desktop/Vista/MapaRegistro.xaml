<Window x:Class="Cliente_AdoptMe.Vista.MapaRegistro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cliente_AdoptMe.Vista"
        xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
        xmlns:p="clr-namespace:Cliente_AdoptMe.Properties"
        mc:Ignorable="d"
        Title="MapaRegistro" Height="900" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <Grid Margin="20">
            <TextBlock Style="{StaticResource Normal}" 
                       FontSize="32"
                       Text="{x:Static p:Resources.txtbl_UbicacionImprecisa}"
                       FontWeight="DemiBold"/>
        </Grid>

        <Grid Grid.Row="1"
              Margin="20,0">
            <gmap:GMapControl x:Name="mapaPrincipal"
                  Zoom="10"/>
        </Grid>

        <Grid Grid.Row="2"
              Margin="20">
            <TextBlock x:Name="datosUbicacion" 
                       Style="{StaticResource Normal}"
                       FontSize="18"
                       Margin="0,0,280,0"/>
            
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                <Button Style="{StaticResource BotonGeneral}"
                        Content="{x:Static p:Resources.global_Guardar}"
                        Background="#44C22B"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        Width="107"
                        Margin="30,0"
                        Click="Aceptar_Click"/>

                <Button Style="{StaticResource BotonGeneral}"
                        Content="{x:Static p:Resources.global_Cancelar}"
                        Background="#D94F4F"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        FontSize="12"  
                        Click="Cancelar_Click"/>
            </StackPanel>
        </Grid>

        <local:CargandoOverlay Grid.RowSpan="3" 
                               x:Name="CargandoOverlay"
                               Visibility="Collapsed" 
                               Panel.ZIndex="999"/>
    </Grid>
</Window>
