<Page x:Class="Cliente_AdoptMe.Vista.Notificaciones"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cliente_AdoptMe.Vista"
      mc:Ignorable="d" 
      d:DesignHeight="940" d:DesignWidth="1518"
      Title="Notificaciones"
      Loaded="Page_Loaded">

    <Grid Background="#ECECEC">
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Margin="40,40,40,0">
            <TextBlock Text="Notificaciones" Style="{StaticResource Titulo}"/>

            <Button Style="{StaticResource BotonGeneral}" 
                    Content="Eliminar todas"
                    Click="Btn_EliminarTodas_Click"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,20"
                    Background="Red"/>
        </Grid>

        <Grid Grid.Row="1"
              Margin="40">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl Name="ListaNotificaciones" ItemsSource="{Binding}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="0 0 0 10" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1260" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Click="Btn_Notificacion_Click"
                                            Tag="{Binding}" 
                                            Padding="10" 
                                            Margin="5"
                                            HorizontalContentAlignment="Left"
                                            Background="#FFEFEFEF">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Text="{Binding Titulo}" FontSize="24"/>
                                            <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" FontSize="18"/>
                                            <TextBlock Text="{Binding Fecha, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="14" Foreground="Gray" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource BotonGeneral}" 
                                            Tag="{Binding}"
                                            Margin="5,0,0,0"
                                            Background="Red"
                                            Width="130"
                                            Click="Btn_Eliminar_Click">
                                        <Image Source="/Recursos/Imagenes/IconoEliminar.png"/>
                                    </Button>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
