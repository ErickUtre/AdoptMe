<Application x:Class="Cliente_AdoptMe.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cliente_AdoptMe"
             xmlns:conv="clr-namespace:Cliente_AdoptMe.Conversores"
             xmlns:utilidades="clr-namespace:Cliente_AdoptMe.Utilidades"
             StartupUri="/Vista/InicioDeSesion.xaml">
    <Application.Resources>
        <utilidades:CadenaVisibilidadConverter x:Key="CadenaVisibilidadConverter" />

        <Style TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" 
                                CornerRadius="15"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2">
                            <Grid>
                                <TextBlock x:Name="TextoSugerido"
                                           Text="{Binding RelativeSource={RelativeSource AncestorType=TextBox}, 
                                                  Path=(utilidades:TextBoxExtensiones.TextoSugerido)}" 
                                           Foreground="Black"
                                           Opacity="0.4"
                                           VerticalAlignment="Center" 
                                           Margin="15,0,0,0" 
                                           Visibility="{Binding Text, RelativeSource={RelativeSource AncestorType=TextBox}, 
                                                        Converter={StaticResource CadenaVisibilidadConverter}}"/>
                                <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.5" />
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="15,5,15,5" />
            <Setter Property="Width" Value="300" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="White" 
                                CornerRadius="15"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2">
                            <Grid>
                                <TextBlock x:Name="TextoSugerido"
                                           Text="{Binding RelativeSource={RelativeSource AncestorType=PasswordBox}, 
                                                  Path=(utilidades:PasswordBoxExtensiones.TextoSugerido)}"  
                                           Foreground="Black"
                                           Opacity="0.4"
                                           VerticalAlignment="Center" 
                                           Margin="15,0,0,0" 
                                           Visibility="{Binding Password, RelativeSource={RelativeSource AncestorType=PasswordBox}, 
                                                        Converter={StaticResource CadenaVisibilidadConverter}}"/>
                                <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.5" />
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="15,5,15,5" />
            <Setter Property="Width" Value="300" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="FuenteBase" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        
        <Style x:Key="Titulo" TargetType="TextBlock" BasedOn="{StaticResource FuenteBase}">
            <Setter Property="FontSize" Value="70"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="Subtitulo1" TargetType="TextBlock" BasedOn="{StaticResource FuenteBase}">
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Subtitulo2" TargetType="TextBlock" BasedOn="{StaticResource FuenteBase}">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TextoMenu" TargetType="TextBlock" BasedOn="{StaticResource FuenteBase}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextoInformacion" TargetType="TextBlock" BasedOn="{StaticResource FuenteBase}">
            <Setter Property="FontSize" Value="38"/>
            <Setter Property="Margin" Value="0,20"/>
        </Style>

        <Style x:Key="Normal" TargetType="TextBlock" BasedOn="{StaticResource FuenteBase}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <ControlTemplate x:Key="PlantallaBaseBoton" TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="EstiloBaseBoton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template" Value="{StaticResource PlantallaBaseBoton}"/>
        </Style>

        <Style x:Key="BotonGeneral" TargetType="Button" BasedOn="{StaticResource EstiloBaseBoton}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="30,9"
                                CornerRadius="25">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.5" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonMenu" TargetType="Button" BasedOn="{StaticResource EstiloBaseBoton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="0,15"
                                CornerRadius="25">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#205766"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconosMenu" TargetType="Image">
            <Setter Property="Width" Value="75"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
        </Style>

        <conv:BooleanToAlignmentConverter x:Key="BooleanToAlignmentConverter" />
        <conv:BooleanToBubbleColorConverter x:Key="BooleanToBubbleColorConverter" />

    </Application.Resources>
</Application>
