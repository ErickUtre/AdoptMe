<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AdoptMe" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primario</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorSecondary">@color/informacion</item>
        <item name="android:windowBackground">@color/fondo</item>
    </style>

    <style name="Theme.AdoptMe.Destacado">
        <item name="android:windowBackground">@color/primario</item>
    </style>

    <style name="Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/espacio_normal</item>
        <item name="boxBackgroundColor">@color/blanco</item>
        <item name="boxCornerRadiusTopStart">@dimen/radio_campo</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radio_campo</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radio_campo</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radio_campo</item>
    </style>

    <style name="Titulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/espacio_grande</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto</item>
    </style>

    <style name="TextoInformacion">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/texto</item>
    </style>

    <style name="BotonNavegacion">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">4dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
