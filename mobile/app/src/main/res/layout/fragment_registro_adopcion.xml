<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margen_pantalla">

            <TextView
                style="@style/Titulo"
                android:layout_marginBottom="@dimen/espacio_pequeno"
                android:text="@string/registrar_adopcion" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espacio_grande"
                android:text="@string/informacion_mascota"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Campo"
                android:hint="@string/nombre_mascota">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLength="45" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Campo"
                android:hint="@string/especie">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoEspecie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="50" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Campo"
                android:hint="@string/raza">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoRaza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="100" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Campo"
                android:hint="@string/edad_anios_meses">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoEdad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sexo" />

            <Spinner
                android:id="@+id/selectorSexo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="@dimen/espacio_normal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tamano" />

            <Spinner
                android:id="@+id/selectorTamano"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="@dimen/espacio_normal" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Campo"
                android:hint="@string/descripcion">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="2000"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonUbicacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/naranja"
                        android:text="@string/elegir_ubicacion" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonFoto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/cian"
                        android:text="@string/subir_foto" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonVideo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/indigo"
                        android:text="@string/subir_video" />

                    <TextView
                        android:id="@+id/textoVideo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/video_seleccionado"
                        android:textColor="@color/texto_secundario" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/vistaPreviaFoto"
                    android:layout_width="@dimen/tamano_foto"
                    android:layout_height="@dimen/tamano_foto"
                    android:layout_marginStart="@dimen/espacio_normal"
                    android:contentDescription="@string/vista_previa"
                    android:scaleType="centerCrop" />
            </LinearLayout>

            <TextView
                android:id="@+id/textoUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_normal"
                android:textColor="@color/texto_secundario" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonRegistrar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/espacio_normal"
                android:backgroundTint="@color/exito"
                android:text="@string/registrar" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/carga"
        layout="@layout/vista_carga" />
</FrameLayout>
