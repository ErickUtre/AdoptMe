<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/margen_pantalla">

            <TextView
                style="@style/Titulo"
                android:text="@string/informacion_mascota" />

            <ImageView
                android:id="@+id/imagenMascota"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:contentDescription="@string/foto_mascota"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/textoNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_grande"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textoEspecie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textoRaza"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textoEdad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textoSexo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textoTamano"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textoDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_normal"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonVerVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_grande"
                android:backgroundTint="@color/informacion"
                android:text="@string/ver_video" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonSolicitar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/exito"
                android:text="@string/solicitar_adopcion"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/carga"
        layout="@layout/vista_carga" />
</FrameLayout>
