<Window x:Class="Cliente_AdoptMe.Vista.MapaRegistro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cliente_AdoptMe.Vista"
        xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
        xmlns:p="clr-namespace:Cliente_AdoptMe.Properties"
        mc:Ignorable="d"
        Title="MapaRegistro" Height="550" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid Margin="10">
            <TextBlock Style="{StaticResource FuenteBase}" 
                       Text="{x:Static p:Resources.txtbl_UbicacionImprecisa}"
                       FontWeight="DemiBold"/>
        </Grid>

        <Grid Grid.Row="1"
              Margin="10,0">
            <gmap:GMapControl x:Name="mapaPrincipal"
                  Zoom="10"/>
        </Grid>

        <Grid Grid.Row="2"
              Margin="10">
            <TextBlock x:Name="datosUbicacion" 
                       Style="{StaticResource FuenteBase}"
                       Margin="0,0,150,0"/>

            <Button Style="{StaticResource BotonGeneral}"
                    Content="{x:Static p:Resources.global_Guardar}"
                    Background="#44C22B"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    FontSize="12"
                    Width="107" 
                    Click="Aceptar_Click"/>

            <Button Style="{StaticResource BotonGeneral}"
                    Content="{x:Static p:Resources.global_Cancelar}"
                    Background="#D94F4F"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    FontSize="12"  
                    Click="Cancelar_Click"/>
        </Grid>
    </Grid>
</Window>
