<Page x:Class="Cliente_AdoptMe.Vista.ConsultarAdopcion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cliente_AdoptMe.Vista"
      mc:Ignorable="d" 
      d:DesignHeight="940" d:DesignWidth="1518"
      Title="ConsultarAdopcion">

    <Grid Background="#EEEEEE">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="40">
            <TextBlock Style="{StaticResource Titulo}" 
                       Text="Información de la mascota" 
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="100,40,10,0" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Margin="0,5" Width="670">
                    <TextBlock Name="Txt_Nombre" Style="{StaticResource TextoInformacion}" Text="Nombre: "/>
                    <Button Width="40" Height="40" Margin="10,0,0,0" Click="Btn_EditarNombre">
                        <Image Source="/Recursos/Imagenes/Editar.png"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5" Width="669">
                    <TextBlock Name="Txt_Especie" Style="{StaticResource TextoInformacion}" Text="Especie: "/>
                    <Button Width="40" Height="40" Margin="10,0,0,0" Click="Btn_EditarEspecie">
                        <Image Source="/Recursos/Imagenes/Editar.png"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5" Width="672">
                    <TextBlock Name="Txt_Raza" Style="{StaticResource TextoInformacion}" Text="Raza: "/>
                    <Button Width="40" Height="40" Margin="10,0,0,0" Click="Btn_EditarRaza">
                        <Image Source="/Recursos/Imagenes/Editar.png"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5" Width="665">
                    <TextBlock Name="Txt_Edad" Style="{StaticResource TextoInformacion}" Text="Edad: "/>
                    <Button Width="40" Height="40" Margin="10,0,0,0" Click="Btn_EditarEdad">
                        <Image Source="/Recursos/Imagenes/Editar.png"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5" Width="689">
                    <TextBlock Name="Txt_Sexo" Style="{StaticResource TextoInformacion}" Text="Sexo: "/>
                    <Button Width="40" Height="40" Margin="10,0,0,0" Click="Btn_EditarSexo">
                        <Image Source="/Recursos/Imagenes/Editar.png"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5" Width="645">
                    <TextBlock Name="Txt_Tamaño" Style="{StaticResource TextoInformacion}" Text="Tamaño: "/>
                    <Button Width="40" Height="40" Margin="10,0,0,0" Click="Btn_EditarTamaño">
                        <Image Source="/Recursos/Imagenes/Editar.png"/>
                    </Button>
                </StackPanel>
            </StackPanel>


            <StackPanel Grid.Column="1" 
                        Margin="40">
                <Grid>
                    <Image x:Name="FotoMascota" 
                           Stretch="UniformToFill"
                           MaxHeight="400">
                        <Image.Effect>
                            <BlurEffect Radius="15"/>
                        </Image.Effect>
                    </Image>

                    <Button Width="40" Height="40" Margin="639,302,0,58" Click="Btn_EditarFoto">
                        <Image Source="/Recursos/Imagenes/Editar.png"/>
                    </Button>

                    <Image Name="FotoComplemento"  
                           Stretch="Uniform"
                           Margin="80,0"/>

                    <Button Style="{StaticResource EstiloBaseBoton}" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Width="50" Click="BtnExpandirImagen">
                        <Image Source="/Recursos/Imagenes/IconoExpandirImagen.png"
                               Opacity="0.8"/>
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,5" Height="188">

                    <Button Width="40" Height="40" Click="Btn_EditarDescripcion">
                        <Image Source="/Recursos/Imagenes/Editar.png"/>
                    </Button>

                    <TextBlock Name="Txt_Descripcion" Style="{StaticResource Normal}" 
                           Margin="0,20"
                           Text="Descripción: " Width="607" Height="131" FontSize="20"/>

                </StackPanel>

            </StackPanel>
            <Button Style="{StaticResource BotonGeneral}"
                Content="Ver video"
                Background="#FFF8C420"
                HorizontalAlignment="Left"
                Margin="569,715,0,-62" Width="150" Click="Btn_VerVideo" Grid.Column="1"/>
        </Grid>

        <Border Grid.Row="2"
                Height="1"
                Margin="40,0"
                Background="#706363"/>

        <Grid Grid.Row="3"
              Margin="996,40,50,40"/>
    </Grid>
</Page>
