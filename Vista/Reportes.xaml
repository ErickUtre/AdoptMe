<Page x:Class="Cliente_AdoptMe.Vista.Reportes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cliente_AdoptMe.Vista"
      mc:Ignorable="d" 
      d:DesignHeight="940" d:DesignWidth="1518"
      Title="Reportes">

    <Grid Background="#EEEEEE">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Botón 1 -->
            <Button Width="500" Height="550" Background="#9272B5" BorderBrush="Transparent" Cursor="Hand" Margin="0,0,50,0" Click="Btn_ReporteMascotasAdoptadas">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Recursos/Imagenes/Cat.png" Width="234" Height="238" Margin="0,10,0,10"/>
                    <TextBlock Text="Reporte de mascotas adoptadas" 
                               TextAlignment="Center" 
                               FontSize="36" 
                               Foreground="White" 
                               TextWrapping="Wrap"
                               Margin="5"/>
                </StackPanel>
            </Button>

            <!-- Botón 2 -->
            <Button Width="500" Height="550" Background="#9272B5" BorderBrush="Transparent" Cursor="Hand" Click="Btn_ReporteMascotasAdopcion" >
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Recursos/Imagenes/Dog.png" Width="258" Height="229" Margin="0,10,0,10"/>
                    <TextBlock Text="Reporte de mascotas en adopción" 
                               TextAlignment="Center" 
                               FontSize="36" 
                               Foreground="White" 
                               TextWrapping="Wrap"
                               Margin="5"/>
                </StackPanel>
            </Button>
        </StackPanel>


    </Grid>
</Page>
