<Page x:Class="Cliente_AdoptMe.Vista.ConsultarAdopciones"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cliente_AdoptMe.Vista"
      xmlns:utilidades="clr-namespace:Cliente_AdoptMe.Utilidades"
      xmlns:p="clr-namespace:Cliente_AdoptMe.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="940" d:DesignWidth="1518"
      Title="ConsultarAdopciones">

    <Grid Background="#EEEEEE">
        <TextBox x:Name="tbNombreMascota" HorizontalAlignment="Left" Margin="979,187,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="439" Height="78" utilidades:TextBoxExtensiones.TextoSugerido="Buscar adopciones" MaxLength="45"/>
        <TextBlock Style="{StaticResource Titulo}" 
                       VerticalAlignment="Top" Margin="43,38,682,0"><Run Language="es-mx" Text="{x:Static p:Resources.txtbl_AdopcionesRegistradas}"/></TextBlock>

        <Image HorizontalAlignment="Left" Height="58" Margin="1339,203,0,0" VerticalAlignment="Top" Width="59" Source="/Recursos/Imagenes/Search.png"/>

        <Button Style="{StaticResource BotonGeneral}"
        Content="{x:Static p:Resources.btn_Eliminar}"
        Background="#FFEA5959"
        HorizontalAlignment="Left"
        Margin="1264,286,0,588" Width="154" Click="Btn_Eliminar"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="106,187,614,0">
            <StackPanel Orientation="Vertical">
                <!-- Tarjeta 1 -->
                <Border Padding="10" BorderBrush="#C3C3C3" BorderThickness="1" CornerRadius="5" Width="716" Height="333" Background="#C3C3C3">
                    <Border.Effect>
                        <DropShadowEffect/>
                    </Border.Effect>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Width="241" >
                            <TextBlock Name="Tb_Nombre" Text="{x:Static p:Resources.global_Nombre}" FontSize="31" Foreground="White" FontWeight="Bold" />
                            <TextBlock Text=" " FontSize="20"/>
                            <TextBlock Name="Tb_Especie" Text="{x:Static p:Resources.global_Especie}" FontSize="18" />
                            <TextBlock Text=" " FontSize="10"/>
                            <TextBlock Name="Tb_Raza" Text="{x:Static p:Resources.global_Raza}" FontSize="18" />
                            <TextBlock Text=" " FontSize="10"/>
                            <TextBlock Name="Tb_Edad" Text="{x:Static p:Resources.global_Edad}" FontSize="18" />
                            <TextBlock Text=" " FontSize="10"/>
                            <StackPanel Orientation="Horizontal" Width="240" >
                                <TextBlock Name="Tb_Estado" Text="{x:Static p:Resources.global_Estado}" Margin="0,0,5,0" FontSize="18" Width="197"/>
                                <Ellipse Name="Ell_Estado" Width="21" Height="20" />
                            </StackPanel>
                        </StackPanel>
                        <Image Name="Foto" Width="306" Height="223" Stretch="UniformToFill" Margin="10,0,0,0" />
                    </DockPanel>
                </Border>

                <!-- Tarjeta 1 -->

            </StackPanel>
        </ScrollViewer>
        <Button Style="{StaticResource BotonGeneral}"
            Content="{x:Static p:Resources.btn_SolicitudesPendientes}"
            Background="#FF64CC20"
            HorizontalAlignment="Left"
            Margin="159,470,0,438" Width="189" Click="Btn_SolicitudesPendientes" FontSize="12"/>
        <Button Style="{StaticResource BotonGeneral}"
            Content="{x:Static p:Resources.btn_Consultar}"
            Background="#FF0A94AB"
            HorizontalAlignment="Left"
            Margin="159,424,0,484" Width="189" Click="Btn_Consultar" FontSize="12"/>

    </Grid>
</Page>
