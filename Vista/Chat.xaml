<Page x:Class="Cliente_AdoptMe.Vista.Chat"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cliente_AdoptMe.Vista"
      xmlns:utilidades="clr-namespace:Cliente_AdoptMe.Utilidades"
      xmlns:p="clr-namespace:Cliente_AdoptMe.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="940" d:DesignWidth="1518"
      Title="Chat">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Background="Black">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Recursos/Imagenes/ImagenPrueba.png"
                       Width="130" 
                       Height="130"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Left"
                       Margin="60,30"
                       ClipToBounds="True">
                    <Image.Clip>
                        <EllipseGeometry RadiusX="65" RadiusY="65" Center="65,65"/>
                    </Image.Clip>
                </Image>
                <TextBlock Style="{StaticResource Subtitulo1}" 
                           Grid.Column="1"
                           Text="Laura Gutiérrez -- Yummi"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" 
              Background="#507663">
            
        </Grid>

        <Grid Grid.Row="2"
              Background="Black">
            <StackPanel Orientation="Horizontal"
                        Margin="30">
                <TextBox x:Name="tbMensaje" 
                         utilidades:TextBoxExtensiones.TextoSugerido="{x:Static p:Resources.txtbl_EnviaUnMensaje}"
                         FontSize="32"
                         Width="1300"
                         Margin="0,0,75,0"
                         Padding="15,20"/>

                <Button Style="{StaticResource EstiloBaseBoton}"
                        Height="80">
                    <Image Source="/Recursos/Imagenes/IconoEnviar.png"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
