<Page x:Class="Cliente_AdoptMe.Vista.Chat"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Cliente_AdoptMe.Vista"
      xmlns:conversores="clr-namespace:Cliente_AdoptMe.Conversores"
      Title="Chat"
      d:DesignHeight="940" d:DesignWidth="1518"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Grid Background="#ECECEC" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Título dinámico -->
        <TextBlock x:Name="TxtTituloChat"
                   Text="Chat"
                   FontSize="36"
                   FontWeight="Bold"
                   Foreground="#207766"
                   Margin="10" />

        <!-- Lista de mensajes -->
        <ScrollViewer x:Name="ScrollMensajes"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Background="#ECECEC"
                      Margin="0,10">
            <ItemsControl ItemsSource="{Binding MensajesUI, RelativeSource={RelativeSource AncestorType=Page}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10">
                            <Border Background="{Binding EsPropio, Converter={StaticResource BooleanToBubbleColorConverter}}"
                                    HorizontalAlignment="{Binding EsPropio, Converter={StaticResource BooleanToAlignmentConverter}}"
                                    CornerRadius="12"
                                    Padding="10"
                                    MaxWidth="400">
                                <StackPanel>
                                    <TextBlock Text="{Binding Contenido}"
                                               TextWrapping="Wrap"
                                               FontSize="16"
                                               Foreground="Black" />
                                    <TextBlock Text="{Binding Hora}"
                                               FontSize="10"
                                               HorizontalAlignment="Right"
                                               Foreground="Gray" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" VerticalAlignment="Center" Height="80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>


            <Button Content="Enviar"
            x:Name="BtnEnviar"
            Grid.Column="1"
            Width="110"
            Margin="0,0,10,0"
            Background="#207766"
            Foreground="White"
            FontWeight="Bold"
            Click="BtnEnviar_Click" />
            
            <TextBox Name="TxtMensaje" HorizontalAlignment="Center" TextWrapping="Wrap" MaxLength="100" 
                     VerticalAlignment="Center" Width="1338" Height="60"/>
        </Grid>


    </Grid>
</Page>
