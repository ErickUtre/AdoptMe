<Window x:Class="Cliente_AdoptMe.Vista.SolicitudesAdopcion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SolicitudesAdopcion" Height="500" Width="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#4A6B5A" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Border BorderBrush="Black" BorderThickness="2" Background="#4A6B5A">
            <DockPanel>
                <!-- Scrollable area -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="300">
                    <StackPanel x:Name="SolicitudesPanel" Margin="10">
                        <!-- Aquí se agregan dinámicamente las solicitudes -->
                    </StackPanel>
                </ScrollViewer>

                <!-- Botón cerrar -->
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,10,10">
                    <Button Content="Cerrar" Width="80" Height="30" Background="#F25C5C" Foreground="White"
                            Click="Cerrar_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
