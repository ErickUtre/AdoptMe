<Page x:Class="Cliente_AdoptMe.Vista.RegistrarAdopcion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cliente_AdoptMe.Vista"
      xmlns:utilidades="clr-namespace:Cliente_AdoptMe.Utilidades"
      xmlns:p="clr-namespace:Cliente_AdoptMe.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="940" d:DesignWidth="1518"
      Title="RegistrarAdopcion">

    <Grid Background="#EEEEEE">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="40">
            <TextBlock Style="{StaticResource Titulo}" 
                       Text="{x:Static p:Resources.txtbl_RegistrarAdopcion}" 
                       VerticalAlignment="Top"/>
        </Grid>

        <Border Grid.Row="2"
                Height="1"
                Margin="40,0"
                Background="#706363"/>

        <Grid Grid.Row="3"
              Margin="50,40">
            <Button Style="{StaticResource BotonGeneral}"
                    Content="{x:Static p:Resources.btn_Registrar}"
                    Background="#3FBD13"
                    HorizontalAlignment="Left"
                    Margin="1254,-21,0,-14" Width="154" Click="Btn_Registrar"/>
            <Button Style="{StaticResource BotonGeneral}"
                Content="{x:Static p:Resources.btn_SubirFoto}"
                Background="#FF3AC1CB"
                HorizontalAlignment="Left"
                Margin="820,-170,0,149" Width="138" Click="Btn_SubirFoto"/>
            
            <Button Style="{StaticResource BotonGeneral}"
                Content="{x:Static p:Resources.btn_SubirVideo}"
                Background="#FFF8C420"
                HorizontalAlignment="Left"
                Margin="806,-117,0,97" Width="152" Click="Btn_SubirVideo"/>
        </Grid>
        <TextBlock HorizontalAlignment="Left" Margin="101,130,0,0" TextWrapping="Wrap" Text="{x:Static p:Resources.txtbl_InformacionMascota}" VerticalAlignment="Top" FontSize="36" Grid.RowSpan="2"/>
        <TextBox Name="tbNombreMascota" HorizontalAlignment="Left" Margin="147,66,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="511" Height="68" utilidades:TextBoxExtensiones.TextoSugerido="{x:Static p:Resources.txtbl_NombreMascota}" MaxLength="45"/>
        <TextBox Name="tbEspecie" HorizontalAlignment="Left" Margin="147,179,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="511" Height="68" utilidades:TextBoxExtensiones.TextoSugerido="{x:Static p:Resources.global_Especie}" MaxLength="50"/>
        <TextBox Name="tbRaza" HorizontalAlignment="Left" Margin="147,0,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="511" Height="68" utilidades:TextBoxExtensiones.TextoSugerido="{x:Static p:Resources.global_Raza}" MaxLength="50"/>
        <TextBox Name="tbMes" HorizontalAlignment="Left" Margin="423,399,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="235" Height="68" utilidades:TextBoxExtensiones.TextoSugerido="{x:Static p:Resources.global_Mes}" MaxLength="2"/>
        <TextBox Name="tbSexo" HorizontalAlignment="Left" Margin="147,510,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="511" Height="68" utilidades:TextBoxExtensiones.TextoSugerido="{x:Static p:Resources.global_Sexo}" MaxLength="50"/>
        <TextBox Name="tbAño" HorizontalAlignment="Left" Margin="147,399,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="235" Height="68" utilidades:TextBoxExtensiones.TextoSugerido="{x:Static p:Resources.global_Anio}" MaxLength="4"/>
        <TextBox Name="tbTamaño" HorizontalAlignment="Left" Margin="861,66,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="511" Height="68" utilidades:TextBoxExtensiones.TextoSugerido="{x:Static p:Resources.global_Tamano}" MaxLength="4"/>
        <TextBox Name="tbDescripcion" HorizontalAlignment="Left" Margin="861,179,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="511" Height="288" utilidades:TextBoxExtensiones.TextoSugerido="{x:Static p:Resources.global_Descripcion}" MaxLength="500"/>
        <Image Name="Foto" HorizontalAlignment="Left" Height="136" Margin="1033,510,0,0" Grid.Row="1" VerticalAlignment="Top" Width="330"/>
        <Label Name="lb_RutaVideo" Content="" HorizontalAlignment="Left" Margin="870,642,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <Button Style="{StaticResource BotonGeneral}" 
            Content="{x:Static p:Resources.btn_ObtenerUbicacion}"
            Background="#00DF82" 
            Click="ObtenerUbicacion_Click" HorizontalAlignment="Left" Margin="806,489,0,142" Grid.Row="1"/>
    </Grid>
</Page>
