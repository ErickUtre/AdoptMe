<Window x:Class="Cliente_AdoptMe.Vista.MenuPrincipalUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cliente_AdoptMe.Vista"
        xmlns:p="clr-namespace:Cliente_AdoptMe.Properties"
        mc:Ignorable="d"
        Title="MenuPrincipalUsuario" Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen" WindowStyle="None" WindowState="Maximized">
    <Window.Resources>
        <Style x:Key="BordeGris" TargetType="Border">
            <Setter Property="Background" Value="#949494"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="Margin" Value="0.20"/>
        </Style>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="412"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid Background="#207766">
                <StackPanel Margin="25">
                    <Grid>
                        <Button Style="{StaticResource EstiloBaseBoton}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Click="Btn_IconoUsuario">
                            <Image x:Name="FotoPerfil" 
                                   Source="/Recursos/Imagenes/IconoUsuarioDefecto.png"
                                   Stretch="UniformToFill"
                                   Width="50" 
                                   Height="50"
                                   ClipToBounds="True">
                                <Image.Clip>
                                    <EllipseGeometry RadiusX="25" RadiusY="25" Center="25,25"/>
                                </Image.Clip>
                            </Image>
                        </Button>

                        <TextBlock Text="{x:Static p:Resources.txtbl_Bienvenido}"
                                   VerticalAlignment="Top"
                                   Margin="60,5"
                                   Foreground="White"/>
                        <TextBlock x:Name="txtblNombreUsuario"
                                   Margin="60,20"
                                   Foreground="White"
                                   FontWeight="Bold"/>
                        <Button Style="{StaticResource EstiloBaseBoton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Click="Btn_CerrarMenuPrincipal">
                            <StackPanel>
                                <Image Source="/Recursos/Imagenes/IconoCerrarSesion.png"
                                       Width="30"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="10,0"/>
                                <TextBlock Text="{x:Static p:Resources.btn_CerrarSesion}"
                                           HorizontalAlignment="Right"
                                           Margin="0,10"
                                           Foreground="White"
                                           FontSize="9"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Image Source="/Recursos/Imagenes/LogoAdoptMe.png"
                           Width="200"
                           MinWidth="100"
                           Margin="0,20,0,0"/>

                    <Border Background="White"
                            Height="2"
                            Margin="-25,50,-25,20"/>

                    <Button Style="{StaticResource BotonMenu}" 
                            Click="Btn_IrMapaPrincipal">
                        <StackPanel Orientation="Horizontal"
                                    Width="360">
                            <Image Style="{StaticResource IconosMenu}"
                                   Source="/Recursos/Imagenes/IconoMenuPrincipal.png"/>
                            <TextBlock Style="{StaticResource TextoMenu}"
                                       Text="{x:Static p:Resources.btn_MenuPrincipal}"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource BordeGris}"/>

                    <Button Style="{StaticResource BotonMenu}" 
                            Click="Btn_IrRegistrarAdopcion">
                        <StackPanel Orientation="Horizontal"
                                    Width="360">
                            <Image Style="{StaticResource IconosMenu}"
                                   Source="/Recursos/Imagenes/IconoRegistrarAdopcion.png"/>
                            <TextBlock Style="{StaticResource TextoMenu}"
                                       Text="{x:Static p:Resources.btn_RegistrarAdopcion}"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource BordeGris}"/>

                    <Button Style="{StaticResource BotonMenu}" 
                            Click="Btn_IrVerAdopciones">
                        <StackPanel Orientation="Horizontal"
                                    Width="360">
                            <Image Style="{StaticResource IconosMenu}"
                                   Source="/Recursos/Imagenes/IconoVerAdopciones.png"/>
                            <TextBlock Style="{StaticResource TextoMenu}"
                                       Text="{x:Static p:Resources.btn_VerAdopciones}"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource BordeGris}"/>

                    <Button Style="{StaticResource BotonMenu}" 
                            Click="Btn_IrMensajes" Height="118">
                        <StackPanel Orientation="Horizontal"
                                    Width="360">
                            <Image Style="{StaticResource IconosMenu}"
                                   Source="/Recursos/Imagenes/IconoMensajes.png" Height="94" Width="73"/>
                            <TextBlock Style="{StaticResource TextoMenu}"
                                       Text="Mensajes"/>
                        </StackPanel>
                    </Button>


                </StackPanel>
            </Grid>

            <Grid Grid.Column="1"
                  Background="#808080">
                <Grid.RowDefinitions>
                    <RowDefinition Height="140"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Frame x:Name="MarcoPrincipal" 
                       Grid.Row="1"
                       NavigationUIVisibility="Hidden"/>
            </Grid>
            <local:CargandoOverlay x:Name="CargandoOverlay"
                                   Grid.ColumnSpan="2" 
                                   Grid.RowSpan="1"
                                   Visibility="Collapsed" />
        </Grid>
    </Viewbox>
</Window>
