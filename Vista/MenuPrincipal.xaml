<Window x:Class="Cliente_AdoptMe.Vista.MenuPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cliente_AdoptMe"
        mc:Ignorable="d"
        Title="MenuPrincipal" Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen" WindowStyle="None" WindowState="Maximized">
    <Window.Resources>
        <Style x:Key="BordeGris" TargetType="Border">
            <Setter Property="Background" Value="#949494"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="Margin" Value="0.20"/>
        </Style>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="412"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid Background="#207766">
                <StackPanel Margin="25">
                    <Grid>
                        <Image Source="/Recursos/Imagenes/IconoUsuario.png"
                               Width="50"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>
                        <TextBlock Text="Bienvenido:"
                                   VerticalAlignment="Top"
                                   Margin="50,5"
                                   Foreground="White"/>
                        <TextBlock Text="Killeresh"
                                   Margin="50,20"
                                   Foreground="White"
                                   FontWeight="Bold"/>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="Transparent" 
                                FocusVisualStyle="{x:Null}"
                                Click="BtnCerrarMenuPrincipal">
                            <StackPanel>
                                <Image Source="/Recursos/Imagenes/IconoCerrarSesion.png"
                                       Width="30"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="10,0"/>
                                <TextBlock Text="Cerrar sesión"
                                           HorizontalAlignment="Right"
                                           Margin="0,10"
                                           Foreground="White"
                                           FontSize="9"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Image Source="/Recursos/Imagenes/LogoAdoptMe.png"
                           Width="200"
                           MinWidth="100"
                           Margin="0,20,0,0"/>

                    <Border Background="White"
                            Height="2"
                            Margin="-25,50,-25,20"/>

                    <Button Style="{StaticResource BotonMenu}">
                        <StackPanel Orientation="Horizontal"
                                    Width="360">
                            <Image Style="{StaticResource IconosMenu}"
                                   Source="/Recursos/Imagenes/IconoMenuPrincipal.png"/>
                            <TextBlock Style="{StaticResource TextoMenu}"
                                       Text="Menú Principal"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource BordeGris}"/>

                    <Button Style="{StaticResource BotonMenu}">
                        <StackPanel Orientation="Horizontal"
                                    Width="360">
                            <Image Style="{StaticResource IconosMenu}"
                                   Source="/Recursos/Imagenes/IconoRegistrarAdopcion.png"/>
                            <TextBlock Style="{StaticResource TextoMenu}"
                                       Text="Registrar adopción"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource BordeGris}"/>

                    <Button Style="{StaticResource BotonMenu}">
                        <StackPanel Orientation="Horizontal"
                                    Width="360">
                            <Image Style="{StaticResource IconosMenu}"
                                   Source="/Recursos/Imagenes/IconoVerAdopciones.png"/>
                            <TextBlock Style="{StaticResource TextoMenu}"
                                       Text="Ver adopciones"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource BordeGris}"/>

                    <Button Style="{StaticResource BotonMenu}"
                            Margin="0,20">
                        <StackPanel Orientation="Horizontal" 
                                    Width="360">
                            <Image Style="{StaticResource IconosMenu}"
                                   Source="/Recursos/Imagenes/IconoMensajes.png"
/>
                            <TextBlock Style="{StaticResource TextoMenu}"
                                       Text="Mensajes"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1"
                  Background="#808080">
                <Grid.RowDefinitions>
                    <RowDefinition Height="140"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Frame x:Name="MarcoPrincipal" 
                       Grid.Row="1"/>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
