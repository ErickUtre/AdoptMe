<Page x:Class="Cliente_AdoptMe.Vista.Mensajes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cliente_AdoptMe.Vista"
      xmlns:p="clr-namespace:Cliente_AdoptMe.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="940" d:DesignWidth="1518"
      Title="Mensajes">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Background="#1E1E1E">
            <TextBlock Style="{StaticResource Titulo}"
                       Text="{x:Static p:Resources.global_Mensajes}"
                       Foreground="White"
                       Margin="50"/>
        </Grid>

        <Grid Grid.Row="1"
              Background="#507663">
            <ListBox x:Name="lbContactos"
                     Margin="50,30"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="1150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Image Source="/Recursos/Imagenes/ImagenPrueba.png"
                                   Margin="20,0,60,0"
                                   Width="130" 
                                   Height="130"
                                   Stretch="UniformToFill"
                                   ClipToBounds="True">
                                <Image.Clip>
                                    <EllipseGeometry RadiusX="65" RadiusY="65" Center="65,65"/>
                                </Image.Clip>
                            </Image>
                            <TextBlock Style="{StaticResource Subtitulo1}" 
                                       Grid.Column="1"
                                       Text="{Binding Nombre}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                            <Separator Grid.ColumnSpan="2"
                                       Grid.Row="1" 
                                       Background="White"
                                       Height="1"
                                       Margin="0,45,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Page>
