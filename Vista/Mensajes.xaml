<Page x:Class="Cliente_AdoptMe.Vista.Mensajes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mensajes">

    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="Mensajes"
                   FontSize="36"
                   FontWeight="Bold"
                   Margin="10"
                   Foreground="#207766" />

        <!-- Lista de Chats -->
        <ListView x:Name="ListViewChats"
                  Grid.Row="1"
                  Margin="10"
                  ItemsSource="{Binding ListaChats}"
                  SelectionChanged="ListViewChats_SelectionChanged"
                  Background="White"
                  BorderBrush="#CCC"
                  BorderThickness="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,0,0,10" BorderBrush="#207766" BorderThickness="0 0 0 1">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding Nombre}"
                                       FontWeight="Bold"
                                       FontSize="28"
                                       Foreground="#207766" />
                            <TextBlock Text="{Binding UltimoMensaje}"
                                       FontSize="20"
                                       Foreground="Gray"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Mensaje cuando no hay chats -->
        <TextBlock x:Name="txtSinMensajes"
                   Grid.Row="1"
                   Text="No hay mensajes disponibles."
                   FontStyle="Italic"
                   FontSize="16"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed" />
    </Grid>
</Page>
