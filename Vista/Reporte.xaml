<Page x:Class="Cliente_AdoptMe.Vista.Reporte"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cliente_AdoptMe.Vista"
      xmlns:p="clr-namespace:Cliente_AdoptMe.Properties"
      xmlns:oxy="http://oxyplot.org/wpf"
      mc:Ignorable="d" 
      d:DesignHeight="940" d:DesignWidth="1518"
      Title="Reporte">

    <Grid Background="#EEEEEE">
        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Style="{StaticResource Titulo}" 
                       Text="{x:Static p:Resources.txtbl_PrevisualizacionReporte}" 
                       VerticalAlignment="Top" Margin="51,48,618,0" FontSize="60"/>

            <Button Style="{StaticResource EstiloBaseBoton}"
                    Click="Btn_Descargar"
                    HorizontalAlignment="Right"
                    Margin="130,0">
                <StackPanel Height="110" Width="105">
                    <Image Source="/Recursos/Imagenes/Download.png"
                           Width="82"
                           Margin="10,0" Height="80">
                        <Image.Effect>
                            <DropShadowEffect/>
                        </Image.Effect>
                    </Image>
                    <TextBlock Text="{x:Static p:Resources.btn_Descargar}"
                               Foreground="Black" HorizontalAlignment="Center" FontSize="14"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2"
              Margin="40">
            <oxy:PlotView x:Name="plotView"/>
        </Grid>
    </Grid>
</Page>
