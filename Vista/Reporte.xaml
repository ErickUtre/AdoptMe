<Page x:Class="Cliente_AdoptMe.Vista.Reporte"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cliente_AdoptMe.Vista"
      mc:Ignorable="d" 
      d:DesignHeight="940" d:DesignWidth="1518"
      Title="Reporte">

    <Grid Background="#EEEEEE">
        <TextBlock Style="{StaticResource Titulo}" 
                       Text="Previsualización reporte" 
                       VerticalAlignment="Top" Margin="51,48,618,0" FontSize="60"/>

        <Button Style="{StaticResource EstiloBaseBoton}"
            Click="Btn_Descargar" Margin="1301,48,97,768">
            <StackPanel Height="110" Width="105">
                <Image Source="/Recursos/Imagenes/Download.png"
               Width="82"
               Margin="10,0" Height="80">
                    <Image.Effect>
                        <DropShadowEffect/>
                    </Image.Effect>
                </Image>
                <TextBlock Text="Descargar"
                   Foreground="Black" HorizontalAlignment="Center" FontSize="14"/>
            </StackPanel>
        </Button>


    </Grid>
</Page>
