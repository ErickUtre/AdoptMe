<Page x:Class="Cliente_AdoptMe.Vista.MapaPrincipal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cliente_AdoptMe.Vista"
      xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
      mc:Ignorable="d" 
      d:DesignHeight="940" d:DesignWidth="1518"
      Title="MapaPrincipal"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">

    <Grid>
        <gmap:GMapControl x:Name="mapaPrincipal"
                          Zoom="10"/>
        <Button x:Name="Btn_ToggleUbicacion" Style="{StaticResource BotonGeneral}" 
                Content="Mostrar ubicación actual"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="30"
                Background="DodgerBlue"
                Click="Btn_ToggleUbicacion_Click"/>
    </Grid>
</Page>
